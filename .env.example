# ====================================================================
# BuildFlow - Environment Variables Example
# Copy to .env and fill in real values. NEVER commit the real .env.
# ====================================================================

# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Mobile ----
EXPO_PUBLIC_API_URL="http://localhost:4000/api"

# ---- Database (PostgreSQL) ----
# Local docker-compose default (see docker-compose.yml)
DATABASE_URL="postgresql://buildflow:buildflow@localhost:5432/buildflow?schema=public"

# ---- Cache / Queue (Redis) ----
# Local: redis://localhost:6379
# Upstash: copy from Console → Redis → "Redis URL" (rediss://..., NOT the REST URL)
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret-32-hex-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-hex-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_COST=12

# ---- CORS ----
# Comma-separated allow-list
CORS_ORIGIN="http://localhost:8081,http://localhost:19006,http://localhost:3000"

# ---- Rate Limiting ----
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=200
RATE_LIMIT_API_WINDOW_MS=60000

# ---- AWS S3 (legacy presigned upload flow for logos/photos) ----
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---- Encrypted File Storage abstraction (tender/bill uploads) ----
# Provider: 'local' (dev) | 's3' (AWS / R2 / B2 / MinIO) | 'drive' (Google Drive).
# Switching providers is a one-line change; ciphertext is provider-agnostic so
# stored files can be copied across providers without re-encryption.
FILE_STORAGE_PROVIDER="local"

# Master key for AES-256-GCM field/file encryption (32 bytes, base64).
# Generate with: openssl rand -base64 32
# REQUIRED in production; optional in dev (a deterministic dev key is used).
FILE_ENCRYPTION_MASTER_KEY=""

# Local storage root (only used when FILE_STORAGE_PROVIDER=local)
FILE_STORAGE_LOCAL_DIR="./.filestore"

# Google Drive service account (only used when FILE_STORAGE_PROVIDER=drive)
# Create a service account in Google Cloud → enable Drive API → share the root
# folder with the service-account email → paste the private key here.
DRIVE_CLIENT_EMAIL=""
DRIVE_PRIVATE_KEY=""
DRIVE_ROOT_FOLDER_ID=""

# ---- Third-party (Phase 4+) ----
# Twilio (WhatsApp / SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_SMS_FROM=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (optional, for international payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google Maps
GOOGLE_MAPS_API_KEY=""

# ---- Chatbot (LLM proxy, OpenAI-compatible) - Phase 5 ----
LLM_API_URL=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# ---- Expo Push Notifications - Phase 5 ----
EXPO_ACCESS_TOKEN=""

# ---- Tally Prime ledger mapping (JSON string) ----
TALLY_LEDGER_MAP='{"sales":"Sales","purchase":"Purchases","tds":"TDS Payable"}'

# ---- Logging ----
LOG_LEVEL="info"
