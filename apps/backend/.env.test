# ====================================================================
# BuildFlow — integration test environment ONLY
# Always uses local buildflow_test DB — never Neon/production.
# Loaded by apps/backend/src/__tests__/setup.ts (override: true).
# ====================================================================

NODE_ENV=test
PORT=4000

EXPO_PUBLIC_API_URL="http://localhost:4000/api"

DATABASE_URL="postgresql://buildflow:buildflow@localhost:5432/buildflow_test?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="test-access-secret-at-least-32-characters-long"
JWT_REFRESH_SECRET="test-refresh-secret-at-least-32-characters-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_COST=8

APP_PUBLIC_URL="http://localhost:8081"
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"

ALLOW_PUBLIC_COMPANY_REGISTRATION=true
TRIAL_DAYS=14
INVITE_TOKEN_EXPIRES_DAYS=7

FILE_ENCRYPTION_MASTER_KEY="WotYMQXImfurZ1BiByblpKaov3RRaSLSHZHUokwjhYE="
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_LOCAL_DIR="./.filestore-test"

RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW_MS=60000

LOG_LEVEL=error
