// ====================================================================
// BuildFlow - Prisma Schema (all 24 models)
// Multi-tenant ready: company_id on every tenant-scoped model.
// ====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums                                                              
// ------------------------------------------------------------------

enum Role {
  OWNER
  PM
  SUPERVISOR
  ACCOUNTANT
}

enum ProjectType {
  HEAVY
  LARGE
  MID
  MINI
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  ON_HOLD
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum ResourceType {
  LABOUR
  MATERIAL
  EQUIPMENT
  SUBCONTRACTOR
}

enum CostType {
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACTOR
  MISC
}

enum EstimateStatus {
  DRAFT
  REVIEWED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ProposalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
  WON
  LOST
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum BillStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum BillCategory {
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

enum InvoiceType {
  STANDARD
  RUNNING_ACCOUNT
  MILESTONE
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum WorkOrderStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReportScheduleType {
  GST_SUMMARY
  TDS_REPORT
  COMPANY_DASHBOARD
  PROJECT_PL
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum TaskConstraintType {
  ASAP
  ALAP
  MUST_START_ON
  MUST_FINISH_ON
  START_NO_EARLIER_THAN
  START_NO_LATER_THAN
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum TicketCategory {
  PROFILE_CHANGE
  COMPANY_CHANGE
  INTEGRATION_SETUP
  BILLING
  BUG
  DATA_FIX
  OTHER
}

enum IntegrationProvider {
  TWILIO
  RAZORPAY
  STRIPE
  TALLY
  GOOGLE_MAPS
  LLM
  S3
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
  ESCALATED
}

enum TicketScope {
  COMPANY
  PLATFORM
}

// ------------------------------------------------------------------
// 1. Company                                                         
// ------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  gstin     String  @unique
  pan       String
  address   String?
  logoUrl   String?  @map("logo_url")
  state     String
  createdAt DateTime @default(now()) @map("created_at")

  subscriptionPlan   SubscriptionPlan   @default(STARTER) @map("subscription_plan")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  trialStartsAt      DateTime           @default(now()) @map("trial_starts_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  lastPaymentAt        DateTime?          @map("last_payment_at")
  saasPaymentRef       String?            @map("saas_payment_ref")

  users               User[]
  userInvites         UserInvite[]
  projects            Project[]
  resources           Resource[]
  rateAnalyses        RateAnalysis[]
  materialPriceHistory MaterialPriceHistory[]
  invoices            Invoice[]
  bills               Bill[]
  journalEntries      JournalEntry[]
  chatMessages        ChatMessage[]
  auditLogs           AuditLog[]
  estimates           Estimate[]
  supportTickets      SupportTicket[]
  integrations        CompanyIntegration[]
  changeOrders        ChangeOrder[]
  subcontractors      Subcontractor[]
  stockLocations      StockLocation[]
  reportSchedules     ReportSchedule[]
  proposals           Proposal[]
  rateRegions         RateRegion[]

  @@map("companies")
}

// ------------------------------------------------------------------
// 2. User                                                            
// ------------------------------------------------------------------

model User {
id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(PM)
  isActive     Boolean  @default(true) @map("is_active")
  notificationPrefs Json? @map("notification_prefs")
  createdAt    DateTime @default(now()) @map("created_at")

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectsCreated      Project[]     @relation("ProjectCreatedBy")
  tasksAssigned        Task[]        @relation("TaskAssignedTo")
  dailyReports         DailyReport[] @relation("DailyReportReportedBy")
  attendances          Attendance[]  @relation("UserAttendance")
  estimatesCreated     Estimate[]    @relation("EstimateCreatedBy")
  estimatesApproved    Estimate[]    @relation("EstimateApprovedBy")
  billsApproved        Bill[]        @relation("BillApprovedBy")
  journalEntries       JournalEntry[] @relation("JournalEntryCreatedBy")
  priceHistoryRecorded MaterialPriceHistory[] @relation("PriceHistoryRecordedBy")
  chatMessages         ChatMessage[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  invitesSent          UserInvite[] @relation("InvitesSent")
  ticketsCreated       SupportTicket[] @relation("TicketsCreated")
  projectMembers       ProjectMember[]
  changeOrdersCreated  ChangeOrder[] @relation("ChangeOrderCreatedBy")
  changeOrdersApproved ChangeOrder[] @relation("ChangeOrderApprovedBy")
  portalAccessCreated  ClientPortalAccess[] @relation("PortalAccessCreatedBy")
  subPortalAccessCreated SubcontractorPortalAccess[] @relation("SubPortalCreatedBy")
  proposalsCreated     Proposal[] @relation("ProposalCreatedBy")
  boqMeasurementsRecorded BoqMeasurement[] @relation("BoqMeasurementRecordedBy")

  @@index([companyId])
  @@map("users")
}

// ------------------------------------------------------------------
// 2b. UserInvite (team onboarding)
// ------------------------------------------------------------------

model UserInvite {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  email       String
  role        Role      @default(PM)
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@map("user_invites")
}

// ------------------------------------------------------------------
// 3. Project
// ------------------------------------------------------------------

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  code            String
  type            ProjectType
  status          ProjectStatus @default(PLANNING)
  clientName      String   @map("client_name")
  clientContact   String?  @map("client_contact")
  locationLat     Float?   @map("location_lat")
  locationLng     Float?   @map("location_lng")
  locationAddress String?  @map("location_address")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  budget          Decimal  @default(0) @db.Decimal(14, 2)
  isTemporary     Boolean  @default(false) @map("is_temporary")
  rateRegionId    String?  @map("rate_region_id") @db.Uuid
  proposalId      String?  @unique @map("proposal_id") @db.Uuid
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rateRegion     RateRegion? @relation(fields: [rateRegionId], references: [id], onDelete: SetNull)
  proposal       Proposal?  @relation("ProjectProposal", fields: [proposalId], references: [id], onDelete: SetNull)
  proposalAsTemp Proposal?  @relation("ProposalTempProject")
  proposalAsPromoted Proposal? @relation("ProposalPromotedProject")
  createdByUser  User       @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  wbsItems       WBSItem[]
  tasks          Task[]
  boqItems       BOQItem[]
  estimates      Estimate[]
  dailyReports   DailyReport[]
  attendances    Attendance[]
  invoices       Invoice[]
  bills          Bill[]
  journalEntries JournalEntry[]
  chatMessages   ChatMessage[]
  members              ProjectMember[]
  changeOrders         ChangeOrder[]
  materialRequisitions MaterialRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceiptNotes    GoodsReceiptNote[]
  stockLocations       StockLocation[]
  subcontractWorkOrders SubcontractWorkOrder[]
  portalAccess         ClientPortalAccess[]
  subcontractorPortalAccess SubcontractorPortalAccess[]
  boqMeasurements      BoqMeasurement[]
  projectMaterialRates ProjectMaterialRate[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isTemporary])
  @@index([rateRegionId])
  @@map("projects")
}

// ------------------------------------------------------------------
// 3b. Proposal (pre-project quoting)                                  
// ------------------------------------------------------------------

model Proposal {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  title              String
  clientName         String         @map("client_name")
  clientContact      String?        @map("client_contact")
  projectType        ProjectType    @map("project_type")
  status             ProposalStatus @default(DRAFT)
  temporaryProjectId String         @unique @map("temporary_project_id") @db.Uuid
  promotedProjectId  String?        @unique @map("promoted_project_id") @db.Uuid
  validUntil         DateTime?      @map("valid_until") @db.Date
  notes              String?
  rejectionReason    String?        @map("rejection_reason")
  createdBy          String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  temporaryProject Project @relation("ProposalTempProject", fields: [temporaryProjectId], references: [id], onDelete: Cascade)
  promotedProject  Project? @relation("ProposalPromotedProject", fields: [promotedProjectId], references: [id], onDelete: SetNull)
  createdByUser    User    @relation("ProposalCreatedBy", fields: [createdBy], references: [id])
  linkedProject    Project? @relation("ProjectProposal")

  @@index([companyId])
  @@index([status])
  @@map("proposals")
}

// ------------------------------------------------------------------
// 4. WBSItem (self-relation)                                         
// ------------------------------------------------------------------

model WBSItem {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  code       String
  name       String
  level      Int      @default(1)
  orderIndex Int      @default(0) @map("order_index")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    WBSItem?  @relation("WBSChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  WBSItem[] @relation("WBSChildren")
  tasks     Task[]
  boqItems  BOQItem[]

  @@index([projectId])
  @@index([parentId])
  @@map("wbs_items")
}

// ------------------------------------------------------------------
// 5. Task                                                            
// ------------------------------------------------------------------

model Task {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  wbsId          String?  @map("wbs_id") @db.Uuid
  name           String
  description    String?
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  durationDays   Int      @default(1) @map("duration_days")
  progressPct    Int      @default(0) @map("progress_pct")
  status         TaskStatus @default(NOT_STARTED)
  assignedTo     String?  @map("assigned_to") @db.Uuid
  constraintType TaskConstraintType? @map("constraint_type")
  isMilestone    Boolean  @default(false) @map("is_milestone")
  createdAt      DateTime @default(now()) @map("created_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbs          WBSItem?          @relation(fields: [wbsId], references: [id], onDelete: SetNull)
  assignee     User?             @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  resources    TaskResource[]
  predecessors TaskPredecessor[] @relation("TaskSuccessors")
  successors   TaskPredecessor[] @relation("TaskPredecessors")
  materialUsages MaterialUsage[]
  dailyReportTaskUpdates DailyReportTaskUpdate[]
  linkedChangeOrders ChangeOrder[]
  subcontractWorkOrders SubcontractWorkOrder[]

  @@index([projectId])
  @@index([wbsId])
  @@index([status])
  @@map("tasks")
}

// ------------------------------------------------------------------
// 6. TaskPredecessor                                                 
// ------------------------------------------------------------------

model TaskPredecessor {
  id             String         @id @default(uuid()) @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  predecessorId  String         @map("predecessor_id") @db.Uuid
  type           DependencyType @default(FS)
  lagDays        Int            @default(0) @map("lag_days")

  task        Task @relation("TaskSuccessors", fields: [taskId], references: [id], onDelete: Cascade)
  predecessor Task @relation("TaskPredecessors", fields: [predecessorId], references: [id], onDelete: Cascade)

  @@unique([taskId, predecessorId])
  @@map("task_predecessors")
}

// ------------------------------------------------------------------
// 7. Resource                                                        
// ------------------------------------------------------------------

model Resource {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  name             String
  type             ResourceType
  unit             String
  rate             Decimal  @default(0) @db.Decimal(12, 2)
  gstRate          Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  hsnSacCode       String?  @map("hsn_sac_code")
  brandOrSpec      String?  @map("brand_or_spec")
  category         String?
  imageUrl         String?  @map("image_url")
  lastRateUpdatedAt DateTime? @map("last_rate_updated_at")
  isActive         Boolean  @default(true) @map("is_active")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskResources      TaskResource[]
  estimateItems      EstimateItem[]
  rateAnalysisComponents RateAnalysisComponent[]
  priceHistory       MaterialPriceHistory[]
  materialUsages     MaterialUsage[]
  requisitionLines   MaterialRequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  changeOrderLines   ChangeOrderLine[]
  regionalMaterialRates RegionalMaterialRate[]
  projectMaterialRates ProjectMaterialRate[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@index([type])
  @@map("resources")
}

// ------------------------------------------------------------------
// 8. TaskResource                                                    
// ------------------------------------------------------------------

model TaskResource {
  id         String  @id @default(uuid()) @db.Uuid
  taskId     String  @map("task_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Decimal @db.Decimal(12, 3)
  unit       String
  rate       Decimal @db.Decimal(12, 2)
  totalCost  Decimal @default(0) @map("total_cost") @db.Decimal(14, 2)

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([taskId, resourceId])
  @@map("task_resources")
}

// ------------------------------------------------------------------
// 9. BOQItem                                                         
// ------------------------------------------------------------------

model BOQItem {
  id            String  @id @default(uuid()) @db.Uuid
  projectId     String  @map("project_id") @db.Uuid
  wbsId         String? @map("wbs_id") @db.Uuid
  itemCode      String  @map("item_code")
  description   String
  unit          String
  quantity      Decimal @db.Decimal(12, 3)
  rate          Decimal @db.Decimal(12, 2)
  amount        Decimal @default(0) @db.Decimal(14, 2)
  category      String?
  estimateItemId String? @map("estimate_item_id") @db.Uuid @unique
  isSuperseded  Boolean @default(false) @map("is_superseded")
  executedQty   Decimal @default(0) @map("executed_qty") @db.Decimal(12, 3)
  procuredQty   Decimal @default(0) @map("procured_qty") @db.Decimal(12, 3)

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbs           WBSItem?          @relation(fields: [wbsId], references: [id], onDelete: SetNull)
  estimateItem  EstimateItem?     @relation(fields: [estimateItemId], references: [id])
  invoiceLines  InvoiceLineItem[]
  measurements  BoqMeasurement[]
  materialUsages MaterialUsage[]
  subcontractWorkOrders SubcontractWorkOrder[]
  subcontractWorkOrderLines SubcontractWorkOrderLine[]
  subcontractMeasurementLines SubcontractMeasurementLine[]

  @@index([projectId])
  @@index([category])
  @@map("boq_items")
}

// ------------------------------------------------------------------
// 10. Estimate                                                       
// ------------------------------------------------------------------

model Estimate {
  id                     String         @id @default(uuid()) @db.Uuid
  projectId              String         @map("project_id") @db.Uuid
  companyId              String         @map("company_id") @db.Uuid
  name                   String
  version                Int            @default(1)
  status                 EstimateStatus @default(DRAFT)
  totalMaterialCost      Decimal        @default(0) @map("total_material_cost") @db.Decimal(14, 2)
  totalLabourCost        Decimal        @default(0) @map("total_labour_cost") @db.Decimal(14, 2)
  totalEquipmentCost     Decimal        @default(0) @map("total_equipment_cost") @db.Decimal(14, 2)
  totalSubcontractorCost Decimal        @default(0) @map("total_subcontractor_cost") @db.Decimal(14, 2)
  totalMiscCost          Decimal        @default(0) @map("total_misc_cost") @db.Decimal(14, 2)
  subtotal               Decimal        @default(0) @db.Decimal(14, 2)
  overheadPct            Decimal        @default(0) @map("overhead_pct") @db.Decimal(5, 2)
  overheadAmount         Decimal        @default(0) @map("overhead_amount") @db.Decimal(14, 2)
  contingencyPct         Decimal        @default(0) @map("contingency_pct") @db.Decimal(5, 2)
  contingencyAmount      Decimal        @default(0) @map("contingency_amount") @db.Decimal(14, 2)
  profitMarginPct        Decimal        @default(0) @map("profit_margin_pct") @db.Decimal(5, 2)
  profitMarginAmount     Decimal        @default(0) @map("profit_margin_amount") @db.Decimal(14, 2)
  gstAmount              Decimal        @default(0) @map("gst_amount") @db.Decimal(14, 2)
  grandTotal             Decimal        @default(0) @map("grand_total") @db.Decimal(14, 2)
  notes                  String?
  rejectionReason        String?        @map("rejection_reason")
  approvedBy             String?        @map("approved_by") @db.Uuid
  approvedAt             DateTime?      @map("approved_at")
  createdBy              String         @map("created_by") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedByUser User?         @relation("EstimateApprovedBy", fields: [approvedBy], references: [id])
  createdByUser  User          @relation("EstimateCreatedBy", fields: [createdBy], references: [id])
  sections    EstimateSection[]
  items       EstimateItem[]

  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@map("estimates")
}

// ------------------------------------------------------------------
// 11. EstimateSection                                                
// ------------------------------------------------------------------

model EstimateSection {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  name        String
  orderIndex  Int      @default(0) @map("order_index")
  description String?

  estimate Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  items    EstimateItem[]

  @@index([estimateId])
  @@map("estimate_sections")
}

// ------------------------------------------------------------------
// 12. EstimateItem                                                   
// ------------------------------------------------------------------

model EstimateItem {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  wbsItemId   String?  @map("wbs_item_id") @db.Uuid
  itemCode    String?  @map("item_code")
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12, 3)
  resourceId      String?  @map("resource_id") @db.Uuid
  rateAnalysisId  String?  @map("rate_analysis_id") @db.Uuid
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(14, 2)
  type        CostType @default(MISC)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  estimate  Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section   EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resource  Resource?  @relation(fields: [resourceId], references: [id])
  rateAnalysis RateAnalysis? @relation(fields: [rateAnalysisId], references: [id], onDelete: SetNull)
  boqItem   BOQItem?

  @@index([estimateId])
  @@index([sectionId])
  @@index([type])
  @@index([rateAnalysisId])
  @@map("estimate_items")
}

// ------------------------------------------------------------------
// 13. RateAnalysis                                                   
// ------------------------------------------------------------------

model RateAnalysis {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  unit        String
  description String?
  totalRate   Decimal  @default(0) @map("total_rate") @db.Decimal(12, 2)
  stale       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  components RateAnalysisComponent[]
  estimateItems EstimateItem[]

  @@index([companyId])
  @@map("rate_analyses")
}

// ------------------------------------------------------------------
// 14. RateAnalysisComponent                                          
// ------------------------------------------------------------------

model RateAnalysisComponent {
  id              String   @id @default(uuid()) @db.Uuid
  rateAnalysisId  String   @map("rate_analysis_id") @db.Uuid
  resourceId      String?  @map("resource_id") @db.Uuid
  miscName        String?  @map("misc_name")
  quantityPerUnit Decimal  @map("quantity_per_unit") @db.Decimal(12, 4)
  unit            String
  rate            Decimal  @db.Decimal(12, 2)
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  type            CostType @default(MISC)

  rateAnalysis RateAnalysis @relation(fields: [rateAnalysisId], references: [id], onDelete: Cascade)
  resource     Resource?    @relation(fields: [resourceId], references: [id])

  @@index([rateAnalysisId])
  @@map("rate_analysis_components")
}

// ------------------------------------------------------------------
// 15. MaterialPriceHistory                                           
// ------------------------------------------------------------------

model MaterialPriceHistory {
  id            String   @id @default(uuid()) @db.Uuid
  resourceId    String   @map("resource_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  rate          Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @map("effective_date") @db.Date
  notes         String?
  recordedBy    String   @map("recorded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recordedByUser User @relation("PriceHistoryRecordedBy", fields: [recordedBy], references: [id])

  @@index([resourceId])
  @@index([companyId])
  @@map("material_price_history")
}

// ------------------------------------------------------------------
// 15b. RateRegion & RegionalMaterialRate                             
// ------------------------------------------------------------------

model RateRegion {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  state     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rates    RegionalMaterialRate[]
  projects Project[]

  @@index([companyId])
  @@map("rate_regions")
}

