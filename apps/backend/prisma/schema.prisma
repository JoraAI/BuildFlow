  vendor     Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  lines      DebitNoteLine[]

  @@index([companyId])
  @@unique([companyId, debitNoteNumber])
  @@map("debit_notes")
}

model DebitNoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  debitNoteId String  @map("debit_note_id") @db.Uuid
  resourceId  String? @map("resource_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unit        String
  rate        Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  gstRate     Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  @@index([debitNoteId])
  @@map("debit_note_lines")
}

