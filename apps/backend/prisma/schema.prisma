  effectiveDate DateTime @map("effective_date") @db.Date
  notes         String?
  recordedBy    String   @map("recorded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recordedByUser User @relation("PriceHistoryRecordedBy", fields: [recordedBy], references: [id])

  @@index([resourceId])
  @@index([companyId])
  @@map("material_price_history")
}

// ------------------------------------------------------------------
// 15b. RateRegion & RegionalMaterialRate                             
// ------------------------------------------------------------------

model RateRegion {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  state     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rates    RegionalMaterialRate[]
  projects Project[]

  @@index([companyId])
  @@map("rate_regions")
}

model RegionalMaterialRate {
  id            String   @id @default(uuid()) @db.Uuid
  regionId      String   @map("region_id") @db.Uuid
  resourceId    String   @map("resource_id") @db.Uuid
  rate          Decimal  @db.Decimal(12, 2)
  unit          String
  effectiveDate DateTime @map("effective_date") @db.Date
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  region   RateRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  resource Resource   @relation(fields: [resourceId], references: [id])

  @@unique([regionId, resourceId, effectiveDate])
  @@index([regionId])
  @@index([resourceId])
  @@map("regional_material_rates")
}

// ------------------------------------------------------------------
// 15c. ProjectMaterialRate                                           
// ------------------------------------------------------------------

model ProjectMaterialRate {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  rate       Decimal  @db.Decimal(12, 2)
  unit       String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([projectId, resourceId])
  @@index([projectId])
  @@map("project_material_rates")
}

// ------------------------------------------------------------------
// 16. DailyReport                                                    
// ------------------------------------------------------------------

model DailyReport {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  reportedBy   String   @map("reported_by") @db.Uuid
  reportDate   DateTime @map("report_date") @db.Date
  weather      String?
  siteStatus   String?  @map("site_status")
  workDone     String?  @map("work_done")
  issues       String?
  photos       String[] @default([])
  workersCount Int      @default(0) @map("workers_count")
  createdAt    DateTime @default(now()) @map("created_at")

  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedByUser User          @relation("DailyReportReportedBy", fields: [reportedBy], references: [id])
  materialUsages MaterialUsage[]
  taskUpdates    DailyReportTaskUpdate[]

  @@unique([projectId, reportDate])
  @@index([projectId])
  @@map("daily_reports")
}

// ------------------------------------------------------------------
// 17. MaterialUsage                                                  
// ------------------------------------------------------------------

model MaterialUsage {
  id           String  @id @default(uuid()) @db.Uuid
  dailyReportId String @map("daily_report_id") @db.Uuid
  resourceId   String  @map("resource_id") @db.Uuid
  quantityUsed Decimal @map("quantity_used") @db.Decimal(12, 3)
  notes        String?
  taskId       String? @map("task_id") @db.Uuid
  boqItemId    String? @map("boq_item_id") @db.Uuid
  boqMeasurementPosted Boolean @default(false) @map("boq_measurement_posted")

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id])
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  boqItem     BOQItem?    @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@index([dailyReportId])
  @@map("material_usages")
}

model DailyReportTaskUpdate {
  id            String @id @default(uuid()) @db.Uuid
  dailyReportId String @map("daily_report_id") @db.Uuid
  taskId        String @map("task_id") @db.Uuid
  progressPct   Int    @map("progress_pct") /// 0–100 enforced via DB CHECK constraint (migration 20260730120200)

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([dailyReportId])
  @@map("daily_report_task_updates")
}

model BoqMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  boqItemId  String   @map("boq_item_id") @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  quantity   Decimal  @db.Decimal(12, 3)
  measuredAt DateTime @default(now()) @map("measured_at")
  recordedBy String   @map("recorded_by") @db.Uuid
  notes      String?

  boqItem  BOQItem @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recorder User    @relation("BoqMeasurementRecordedBy", fields: [recordedBy], references: [id])

  @@index([boqItemId])
  @@index([projectId])
  @@map("boq_measurements")
}

// ------------------------------------------------------------------
// 16b. Attendance (geo-fence check-in/out)
// ------------------------------------------------------------------

model Attendance {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  checkInAt       DateTime  @map("check_in_at")
  checkOutAt      DateTime? @map("check_out_at")
  checkInLat      Float     @map("check_in_lat")
  checkInLng      Float     @map("check_in_lng")
  distanceFromSite Float    @default(0) @map("distance_from_site") // metres
  withinFence     Boolean   @default(false) @map("within_fence")
  notes           String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("UserAttendance", fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([checkInAt])
  @@map("attendances")
}

// ------------------------------------------------------------------
// 18. Invoice                                                        
// ------------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  invoiceNumber String        @map("invoice_number")
  clientName    String        @map("client_name")
  clientGstin   String?       @map("client_gstin")
  // FIX (FIN-H3/NR-5): Persist the client's state so edits don't silently flip
  // CGST/SGST → IGST (previously clientState was never stored, so on update it
  // resolved to undefined → always inter-state).
  clientState   String?       @map("client_state")
  // INVENTORY_UX_POLISH (D6): optional buyer contact details for store sales invoices.
  clientAddress String?       @map("client_address")
  clientPhone   String?       @map("client_phone")
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  gstRate       Decimal       @default(0) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount     Decimal       @default(0) @map("gst_amount") @db.Decimal(14, 2)
  cgstAmount    Decimal       @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount    Decimal       @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount    Decimal       @default(0) @map("igst_amount") @db.Decimal(14, 2)
  tdsRate       Decimal       @default(0) @map("tds_rate") @db.Decimal(5, 2)
  tdsAmount     Decimal       @default(0) @map("tds_amount") @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  notes         String?
  stockMovementId String?     @map("stock_movement_id") @db.Uuid
  invoiceType   InvoiceType   @default(STANDARD) @map("invoice_type")
  raSequence    Int?          @map("ra_sequence")
  milestoneLabel String?      @map("milestone_label")
  retentionPct  Decimal       @default(0) @map("retention_pct") @db.Decimal(5, 2)
  retentionAmount Decimal     @default(0) @map("retention_amount") @db.Decimal(14, 2)
  previousCertifiedTotal Decimal @default(0) @map("previous_certified_total") @db.Decimal(14, 2)
  currentCertifiedTotal  Decimal @default(0) @map("current_certified_total") @db.Decimal(14, 2)
  cumulativeCertifiedTotal Decimal @default(0) @map("cumulative_certified_total") @db.Decimal(14, 2)

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovement StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  lineItems InvoiceLineItem[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 1.1): optional party-master link.
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String? @map("customer_id") @db.Uuid
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 2.1): invoice created from a sales order.
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesOrderId String? @map("sales_order_id") @db.Uuid
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 2.2/2.4): returns + credit notes.
  salesReturns SalesReturn[]
  creditNotes  CreditNote[]

  @@unique([companyId, invoiceNumber])
  @@unique([stockMovementId])
  @@index([projectId])
  @@index([companyId])
  @@index([status])
  @@index([invoiceType])
  // R2-11: The partial unique index on (project_id, ra_sequence) WHERE
  // ra_sequence IS NOT NULL is created in migration 20260730120100. It is NOT
  // declared here as a Prisma @@unique because Prisma cannot express partial
  // unique indexes (filtered). Do NOT regenerate migrations for this model
  // without preserving this index — it guards against duplicate RA sequences.
  // Raw SQL to recreate if dropped:
  //   CREATE UNIQUE INDEX "invoices_projectid_rasequence_unique"
  //     ON "invoices" ("project_id", "ra_sequence") WHERE "ra_sequence" IS NOT NULL;
  // FIX (DAT-3.6): Composite index for tenant+status queries.
  @@index([companyId, status])
  @@map("invoices")
}

// ------------------------------------------------------------------
// 19. InvoiceLineItem                                                
// ------------------------------------------------------------------

model InvoiceLineItem {
  id         String  @id @default(uuid()) @db.Uuid
  invoiceId  String  @map("invoice_id") @db.Uuid
  boqItemId  String? @map("boq_item_id") @db.Uuid
  description String
  quantity   Decimal @db.Decimal(12, 3)
  unit       String
  rate       Decimal @db.Decimal(12, 2)
  amount     Decimal @default(0) @db.Decimal(14, 2)
  gstRate    Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  hsnSacCode String? @map("hsn_sac_code")
  previousQty Decimal @default(0) @map("previous_qty") @db.Decimal(12, 3)
  currentQty  Decimal @default(0) @map("current_qty") @db.Decimal(12, 3)
  cumulativeQty Decimal @default(0) @map("cumulative_qty") @db.Decimal(12, 3)
  certifiedAmount Decimal @default(0) @map("certified_amount") @db.Decimal(14, 2)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 8.4): optional link to the item catalog
  // so margin reports can use billed amounts instead of the catalog rate.
  resourceId  String? @map("resource_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  boqItem BOQItem? @relation(fields: [boqItemId], references: [id])
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  // FIX (DAT-3.6): Add index for BOQ item lookups.
  @@index([boqItemId])
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 8.4): margin rollups by item.
  @@index([resourceId])
  @@map("invoice_line_items")
}

// ------------------------------------------------------------------
// 20. Bill                                                           
// ------------------------------------------------------------------

model Bill {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  billNumber  String      @map("bill_number")
  vendorName  String      @map("vendor_name")
  vendorGstin String?     @map("vendor_gstin")
  billDate    DateTime    @map("bill_date") @db.Date
  dueDate     DateTime?   @map("due_date") @db.Date
  status      BillStatus  @default(PENDING)
  subtotal    Decimal     @default(0) @db.Decimal(14, 2)
  gstAmount   Decimal     @default(0) @map("gst_amount") @db.Decimal(14, 2)
  tdsRate     Decimal     @default(0) @map("tds_rate") @db.Decimal(5, 2)
  tdsAmount   Decimal     @default(0) @map("tds_amount") @db.Decimal(14, 2)
  total       Decimal     @default(0) @db.Decimal(14, 2)
  category    BillCategory @default(OTHER)
  attachmentUrl String?   @map("attachment_url")
  approvedBy  String?     @map("approved_by") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid
  goodsReceiptId String? @map("goods_receipt_id") @db.Uuid
  workOrderId String?     @map("work_order_id") @db.Uuid
  measurementId String?   @map("measurement_id") @db.Uuid
  retentionAmount Decimal @default(0) @map("retention_amount") @db.Decimal(14, 2)
  advanceRecoveryAmount Decimal @default(0) @map("advance_recovery_amount") @db.Decimal(14, 2)
  paidAmount  Decimal     @default(0) @map("paid_amount") @db.Decimal(14, 2)
  paidAt      DateTime?   @map("paid_at")
  isRetentionRelease Boolean @default(false) @map("is_retention_release")
  billSnapshot   Json?     @map("bill_snapshot")
  createdAt   DateTime    @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedByUser User? @relation("BillApprovedBy", fields: [approvedBy], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt GoodsReceiptNote? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  workOrder SubcontractWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  measurement SubcontractMeasurement? @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 1.1): optional party-master link.
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId String? @map("vendor_id") @db.Uuid
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 2.3/2.4): returns + debit notes.
  purchaseReturns PurchaseReturn[]
  debitNotes      DebitNote[]

  @@unique([companyId, billNumber])
  @@unique([goodsReceiptId])
  @@index([projectId])
  @@index([status])
  // FIX (DAT-3.6): Composite index for tenant+status queries.
  @@index([companyId, status])
  @@map("bills")
}

// ------------------------------------------------------------------
// INVENTORY_HORIZONTAL_PLATFORM (Phase 2) — Transaction engine
// ------------------------------------------------------------------

model SalesOrder {
  id             String            @id @default(uuid()) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  soNumber       String            @map("so_number")
  customerId     String?           @map("customer_id") @db.Uuid
  customerName   String            @map("customer_name")
  status         SalesOrderStatus  @default(DRAFT)
  orderDate      DateTime          @map("order_date") @db.Date
  expectedDelivery DateTime?       @map("expected_delivery") @db.Date
  notes          String?
  subtotal       Decimal           @default(0) @db.Decimal(14, 2)
  gstAmount      Decimal           @default(0) @map("gst_amount") @db.Decimal(14, 2)
  total          Decimal           @default(0) @db.Decimal(14, 2)
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines            SalesOrderLine[]
  deliveryChallans DeliveryChallan[]
  invoices         Invoice[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 9.2): sales order created from an accepted quote.
  quote            Quote?             @relation("QuoteSalesOrder")

  @@index([companyId])
  @@unique([companyId, soNumber])
  @@map("sales_orders")
}

model SalesOrderLine {
  id            String  @id @default(uuid()) @db.Uuid
  salesOrderId  String  @map("sales_order_id") @db.Uuid
  resourceId    String  @map("resource_id") @db.Uuid
  itemName      String  @map("item_name")
  unit          String
  quantity      Decimal @db.Decimal(12, 3)
  rate          Decimal @default(0) @db.Decimal(12, 2)
  amount        Decimal @default(0) @db.Decimal(14, 2)
  gstRate       Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)
  deliveredQty  Decimal @default(0) @map("delivered_qty") @db.Decimal(12, 3)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model DeliveryChallan {
  id           String                @id @default(uuid()) @db.Uuid
  companyId    String                @map("company_id") @db.Uuid
  projectId    String                @map("project_id") @db.Uuid
