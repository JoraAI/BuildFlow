  @@index([companyId])
  @@unique([companyId, dcNumber])
  @@map("delivery_challans")
}

model DeliveryChallanLine {
  id                String  @id @default(uuid()) @db.Uuid
  deliveryChallanId String  @map("delivery_challan_id") @db.Uuid
  salesOrderLineId  String? @map("sales_order_line_id") @db.Uuid
  resourceId        String  @map("resource_id") @db.Uuid
  itemName          String  @map("item_name")
  unit              String
  quantity          Decimal @db.Decimal(12, 3)
  rate              Decimal @default(0) @db.Decimal(12, 2)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 8.3): optional batch / lot code (lite).
  batchCode         String? @map("batch_code")

  deliveryChallan DeliveryChallan @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)
  @@index([deliveryChallanId])
  @@map("delivery_challan_lines")
}

model SalesReturn {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  projectId    String        @map("project_id") @db.Uuid
