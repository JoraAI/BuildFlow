  locationId String  @map("location_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Decimal @default(0) @db.Decimal(12, 3)

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource Resource      @relation(fields: [resourceId], references: [id])

  @@unique([locationId, resourceId])
  @@map("stock_balances")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  resourceId    String            @map("resource_id") @db.Uuid
  quantity      Decimal           @db.Decimal(12, 3)
  type          StockMovementType
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource Resource      @relation(fields: [resourceId], references: [id])

  @@index([locationId])
  @@map("stock_movements")
}

// ------------------------------------------------------------------
// Subcontractors
// ------------------------------------------------------------------

model Subcontractor {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  gstin          String?
  contactPhone   String?  @map("contact_phone")
  defaultTdsRate Decimal  @default(0) @map("default_tds_rate") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrders   SubcontractWorkOrder[]
  portalAccess SubcontractorPortalAccess[]

  @@index([companyId])
  @@map("subcontractors")
}

model SubcontractWorkOrder {
  id              String          @id @default(uuid()) @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  subcontractorId String          @map("subcontractor_id") @db.Uuid
  boqItemId       String?         @map("boq_item_id") @db.Uuid
  taskId          String?         @map("task_id") @db.Uuid
  woNumber        String          @map("wo_number")
  scope           String
  contractValue   Decimal         @default(0) @map("contract_value") @db.Decimal(14, 2)
  retentionPct    Decimal         @default(0) @map("retention_pct") @db.Decimal(5, 2)
  advanceAmount   Decimal         @default(0) @map("advance_amount") @db.Decimal(14, 2)
  status          WorkOrderStatus @default(DRAFT)
  startDate       DateTime?       @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  retentionReleasedAt DateTime?   @map("retention_released_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  project              Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor        Subcontractor           @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  boqItem              BOQItem?                @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  task                 Task?                   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  contractLines        SubcontractWorkOrderLine[]
  measurements         SubcontractMeasurement[]
  bills                Bill[]
  linkedChangeOrders   ChangeOrder[]
  portalAccess         SubcontractorPortalAccess[]

  @@unique([projectId, woNumber])
  @@index([boqItemId])
  @@index([taskId])
  @@map("subcontract_work_orders")
}

model SubcontractWorkOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  workOrderId  String  @map("work_order_id") @db.Uuid
  boqItemId    String? @map("boq_item_id") @db.Uuid
  description  String
  unit         String
  contractQty  Decimal @map("contract_qty") @db.Decimal(12, 3)
  rate         Decimal @db.Decimal(12, 2)
  amount       Decimal @default(0) @db.Decimal(14, 2)

  workOrder SubcontractWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  boqItem   BOQItem?             @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  measurementLines SubcontractMeasurementLine[]

  @@index([workOrderId])
  @@map("subcontract_work_order_lines")
}

model SubcontractMeasurement {
  id              String         @id @default(uuid()) @db.Uuid
  workOrderId     String         @map("work_order_id") @db.Uuid
  periodLabel     String         @map("period_label")
  status          ApprovalStatus @default(DRAFT)
  totalAmount     Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  rejectionReason String?        @map("rejection_reason")
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  workOrder SubcontractWorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lines     SubcontractMeasurementLine[]
  bills     Bill[]

  @@index([workOrderId])
  @@map("subcontract_measurements")
}

model SubcontractMeasurementLine {
  id                   String  @id @default(uuid()) @db.Uuid
  measurementId        String  @map("measurement_id") @db.Uuid
  workOrderLineId      String? @map("work_order_line_id") @db.Uuid
  boqItemId            String? @map("boq_item_id") @db.Uuid
  description          String
  quantity             Decimal @db.Decimal(12, 3)
  unit                 String
  rate                 Decimal @db.Decimal(12, 2)
  amount               Decimal @default(0) @db.Decimal(14, 2)
  boqMeasurementPosted Boolean @default(false) @map("boq_measurement_posted")

  measurement   SubcontractMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  workOrderLine SubcontractWorkOrderLine? @relation(fields: [workOrderLineId], references: [id], onDelete: SetNull)
  boqItem       BOQItem?               @relation(fields: [boqItemId], references: [id], onDelete: SetNull)

  @@index([measurementId])
  @@map("subcontract_measurement_lines")
}

model SubcontractorPortalAccess {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  subcontractorId String   @map("subcontractor_id") @db.Uuid
  workOrderId     String?  @map("work_order_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash")
  label           String
  scopes          String[]
  expiresAt       DateTime @map("expires_at")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor         @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  workOrder     SubcontractWorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdByUser User                  @relation("SubPortalCreatedBy", fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("subcontractor_portal_access")
}

// ------------------------------------------------------------------
// Client portal
// ------------------------------------------------------------------

model ClientPortalAccess {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  label     String
  scopes    String[]
  expiresAt DateTime @map("expires_at")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("PortalAccessCreatedBy", fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("client_portal_access")
}

// ------------------------------------------------------------------
// Scheduled reports
// ------------------------------------------------------------------

model ReportSchedule {
  id         String             @id @default(uuid()) @db.Uuid
  companyId  String             @map("company_id") @db.Uuid
  reportType ReportScheduleType @map("report_type")
  cronExpr   String             @map("cron_expr")
  recipients String[]
  lastRunAt  DateTime?          @map("last_run_at")
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("report_schedules")
}

// ------------------------------------------------------------------
// 26. PlatformAdmin (BuildFlow internal ops)
// ------------------------------------------------------------------

model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  auditLogs PlatformAuditLog[]

  @@map("platform_admins")
}

model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  action    String
  companyId String?  @map("company_id") @db.Uuid
  targetId  String?  @map("target_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([companyId])
  @@map("platform_audit_logs")
}