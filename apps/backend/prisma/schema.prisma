// ------------------------------------------------------------------
// Procurement
// ------------------------------------------------------------------

model MaterialRequisition {
  id          String         @id @default(uuid()) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  reqNumber   String         @map("req_number")
  status      ApprovalStatus @default(DRAFT)
  notes       String?
  sourceType  String?        @map("source_type")
  sourceRef   String?        @map("source_ref")
  requestedBy String         @map("requested_by") @db.Uuid
  approvedBy  String?        @map("approved_by") @db.Uuid
  // E-signature
  signedBy      String?        @map("signed_by") @db.Uuid
  signedAt      DateTime?      @map("signed_at")
  signedByName  String?        @map("signed_by_name")
  signatureHash String?        @map("signature_hash")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   MaterialRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, reqNumber])
