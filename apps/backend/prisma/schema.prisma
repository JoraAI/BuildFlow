model MaterialRequisitionLine {
  id            String  @id @default(uuid()) @db.Uuid
  requisitionId String  @map("requisition_id") @db.Uuid
  // FIX (NR-13): Nullable so BOQ-only lines (no catalog resource) can be saved.
  resourceId    String? @map("resource_id") @db.Uuid
  boqItemId     String? @map("boq_item_id") @db.Uuid
  quantity      Decimal @db.Decimal(12, 3)
  unit          String
  expectedRate  Decimal? @map("expected_rate") @db.Decimal(12, 2)
  rateSource    String?  @map("rate_source")

  requisition MaterialRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  resource    Resource?           @relation(fields: [resourceId], references: [id])

  @@index([requisitionId])
  @@map("material_requisition_lines")
}

model PurchaseOrder {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  requisitionId String?        @map("requisition_id") @db.Uuid
  poNumber      String         @map("po_number")
  vendorName    String         @map("vendor_name")
  vendorGstin   String?        @map("vendor_gstin")
  vendorAddress String?        @map("vendor_address")
  deliveryDate  DateTime?      @map("delivery_date") @db.Date
  paymentTerms  String?        @map("payment_terms")
  notes         String?
  status        ApprovalStatus @default(DRAFT)
  totalAmount   Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  // E-signature
  signedBy      String?        @map("signed_by") @db.Uuid
  signedAt      DateTime?      @map("signed_at")
  signedByName  String?        @map("signed_by_name")
  signatureHash String?        @map("signature_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requisition MaterialRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  lines       PurchaseOrderLine[]
  goodsReceipts GoodsReceiptNote[]
  bills       Bill[]

  @@unique([companyId, poNumber])
  @@index([projectId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  resourceId      String  @map("resource_id") @db.Uuid
  quantity        Decimal @db.Decimal(12, 3)
  unit            String
  rate            Decimal @db.Decimal(12, 2)
  amount          Decimal @default(0) @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  resource      Resource      @relation(fields: [resourceId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceiptNote {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  grnNumber       String   @map("grn_number")
  receivedDate    DateTime @map("received_date") @db.Date
  notes           String?
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 5.1): landed costs — extra acquisition
  // costs allocated to lines (by quantity or value) and added to unit cost.
  freightCost         Decimal @default(0) @map("freight_cost") @db.Decimal(14, 2)
  insuranceCost       Decimal @default(0) @map("insurance_cost") @db.Decimal(14, 2)
  handlingCost        Decimal @default(0) @map("handling_cost") @db.Decimal(14, 2)
  customsCost         Decimal @default(0) @map("customs_cost") @db.Decimal(14, 2)
  landedCostAllocation String @default("QUANTITY") @map("landed_cost_allocation")
  createdAt       DateTime @default(now()) @map("created_at")

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines         GoodsReceiptLine[]
  bills         Bill[]

  @@unique([companyId, grnNumber])
  @@index([projectId])
  @@map("goods_receipt_notes")
}

model GoodsReceiptLine {
  id         String  @id @default(uuid()) @db.Uuid
  grnId      String  @map("grn_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Decimal @db.Decimal(12, 3)
  unit       String
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 5.1): landed unit cost (PO rate +
  // allocated extras) for this receipt.
  unitCost   Decimal @default(0) @map("unit_cost") @db.Decimal(14, 4)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 8.3): optional batch / lot code (lite).
  batchCode  String? @map("batch_code")

  grn      GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  resource Resource         @relation(fields: [resourceId], references: [id])

  @@index([grnId])
  @@map("goods_receipt_lines")
}

model StockLocation {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  name      String
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 3.1): multi-warehouse fields.
  code      String?
  address   String?
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  balances StockBalance[]
  movements StockMovement[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 3.2/3.3): transfer + stock-count relations.
  transferOrdersFrom TransferOrder[] @relation("TransferFromLocation")
  transferOrdersTo   TransferOrder[] @relation("TransferToLocation")
  stockCounts        StockCount[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("stock_locations")
}

model StockBalance {
  id         String  @id @default(uuid()) @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Decimal @default(0) @db.Decimal(12, 3)

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource Resource      @relation(fields: [resourceId], references: [id])

  @@unique([locationId, resourceId])
  @@map("stock_balances")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  locationId    String            @map("location_id") @db.Uuid
  resourceId    String            @map("resource_id") @db.Uuid
  quantity      Decimal           @db.Decimal(12, 3)
  type          StockMovementType
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 1.3): adjustment audit trail.
  reason        String?           @map("reason")
  notes         String?           @map("notes")
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 5.2): cost metadata on movements —
  // unitCost is the WAC at the time of the movement; inventoryValue = qty × WAC.
  unitCost       Decimal           @default(0) @map("unit_cost") @db.Decimal(14, 4)
  inventoryValue Decimal           @default(0) @map("inventory_value") @db.Decimal(14, 2)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 8.3): optional batch / lot code (lite —
  // no serial numbers, expiry or FEFO yet). Copied from the GRN/issue/DC line.
  batchCode     String?            @map("batch_code")
  createdAt     DateTime          @default(now()) @map("created_at")

  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource Resource      @relation(fields: [resourceId], references: [id])
  invoices Invoice[]

  @@index([locationId])
  // FIX (DAT-3.6): Add indexes for resource and reference lookups.
  @@index([resourceId])
  @@index([referenceId])
  @@map("stock_movements")
}

