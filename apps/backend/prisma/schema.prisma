// ====================================================================
// BuildFlow - Prisma Schema (all 24 models)
// Multi-tenant ready: company_id on every tenant-scoped model.
// ====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums                                                              
// ------------------------------------------------------------------

enum Role {
  OWNER
  PM
  DPM
  QC
  MECHANICAL_MANAGER
  STORE_INCHARGE
  WEIGHBRIDGE_INCHARGE
  SITE_SUPERVISOR
  /// @deprecated — kept for backward compat; use SITE_SUPERVISOR
  SUPERVISOR
  ACCOUNTANT
  /// Inventory product role — hidden from construction companies
  INVENTORY_MANAGER
}

enum ProjectType {
  HEAVY
  LARGE
  MID
  MINI
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  ON_HOLD
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum ResourceType {
  LABOUR
  MATERIAL
  EQUIPMENT
  SUBCONTRACTOR
}

enum CostType {
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACTOR
  MISC
}

enum EstimateStatus {
  DRAFT
  REVIEWED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ProposalStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
  WON
  LOST
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum BillStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum BillCategory {
  MATERIAL
  LABOUR
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

enum InvoiceType {
  STANDARD
  RUNNING_ACCOUNT
  MILESTONE
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

/// INVENTORY_HORIZONTAL_PLATFORM (Phase 2): transaction engine enums.
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  INVOICED
  CANCELLED
}

enum DeliveryChallanStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

/// Line-level condition when goods come back from a customer.
enum ReturnKind {
  GOOD
  DAMAGED
}

enum NoteStatus {
  DRAFT
  ISSUED
  VOID
}

/// Customer credit-limit enforcement policy (Phase 2.5).
enum CreditLimitPolicy {
  ALLOW
  WARN
  BLOCK
}

/// INVENTORY_HORIZONTAL_PLATFORM (Phase 3.2): inter-location stock transfer.
enum TransferOrderStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

/// INVENTORY_HORIZONTAL_PLATFORM (Phase 3.3): stock-count / stocktake workflow.
enum StockCountStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MaterialSupplyMode {
  NONE
  GC_SUPPLIED
  MIXED
}

enum ReportScheduleType {
  GST_SUMMARY
  TDS_REPORT
  COMPANY_DASHBOARD
  PROJECT_PL
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

enum TaskConstraintType {
  ASAP
  ALAP
  MUST_START_ON
  MUST_FINISH_ON
  START_NO_EARLIER_THAN
  START_NO_LATER_THAN
}

enum SubscriptionPlan {
  /// Inventory product — hidden default STORE project, inventory-only shell
  INVENTORY
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

/// INVENTORY_HORIZONTAL_PLATFORM (Phase 0): optional business profile for
/// inventory tenants (drives terminology + future phase branches).
enum InventoryBusinessProfile {
  RETAIL
  WHOLESALE
  DISTRIBUTION
  TRADING
  MATERIAL_SUPPLIER
  EQUIPMENT
  GENERAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum TicketCategory {
  PROFILE_CHANGE
  COMPANY_CHANGE
  INTEGRATION_SETUP
  BILLING
  BUG
  DATA_FIX
  OTHER
}

enum IntegrationProvider {
  TWILIO
  RAZORPAY
  STRIPE
  TALLY
  GOOGLE_MAPS
  LLM
  S3
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
  ESCALATED
}

enum TicketScope {
  COMPANY
  PLATFORM
}

// ------------------------------------------------------------------
// 1. Company                                                         
// ------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  gstin     String  @unique
  pan       String
  address   String?
  logoUrl   String?  @map("logo_url")
  reportSettings Json? @map("report_settings")
  state     String
  createdAt DateTime @default(now()) @map("created_at")

  subscriptionPlan   SubscriptionPlan   @default(STARTER) @map("subscription_plan")
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  trialStartsAt      DateTime           @default(now()) @map("trial_starts_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  lastPaymentAt        DateTime?          @map("last_payment_at")
  saasPaymentRef       String?            @map("saas_payment_ref")

  /// INVENTORY_PRODUCT: the hidden default store project (code 'STORE').
  defaultProjectId String?   @unique @map("default_project_id") @db.Uuid
  defaultProject   Project?  @relation("CompanyDefaultProject", fields: [defaultProjectId], references: [id], onDelete: SetNull)

  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 0): optional business profile —
  /// RETAIL/WHOLESALE/DISTRIBUTION/TRADING/MATERIAL_SUPPLIER/EQUIPMENT/GENERAL.
  /// Hidden/ignored on construction plans (service returns null). DB default
  /// GENERAL backfills existing rows; new inventory tenants start GENERAL.
  inventoryProfile InventoryBusinessProfile? @default(GENERAL) @map("inventory_profile")

  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 2.5): credit-limit enforcement policy.
  creditLimitPolicy CreditLimitPolicy @default(WARN) @map("credit_limit_policy")

  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 4.4): PO approval thresholds (₹).
  /// 0 (default) = feature off → inventory POs auto-approve like today.
  /// total < poAutoApproveBelow → APPROVED; ≤ poOwnerApproveAbove → manager
  /// approves; > poOwnerApproveAbove → OWNER only.
  poAutoApproveBelow Decimal @default(0) @map("po_auto_approve_below") @db.Decimal(14, 2)
  poOwnerApproveAbove Decimal @default(0) @map("po_owner_approve_above") @db.Decimal(14, 2)

  users               User[]
  userInvites         UserInvite[]
  projects            Project[]
  resources           Resource[]
  rateAnalyses        RateAnalysis[]
  materialPriceHistory MaterialPriceHistory[]
  invoices            Invoice[]
  bills               Bill[]
  journalEntries      JournalEntry[]
  chatMessages        ChatMessage[]
  auditLogs           AuditLog[]
  estimates           Estimate[]
  supportTickets      SupportTicket[]
  integrations        CompanyIntegration[]
  changeOrders        ChangeOrder[]
  subcontractors      Subcontractor[]
  stockLocations      StockLocation[]
  reportSchedules     ReportSchedule[]
  proposals           Proposal[]
  rateRegions         RateRegion[]
  rolePermissions     CompanyRolePermission[]
  documentCounters    DocumentCounter[]
  pettyCashEntries    PettyCashEntry[]
  punchItems          PunchItem[]
  rfis                RFI[]
  submittals          Submittal[]
  drawings            Drawing[]
  subcontractWorkOrders SubcontractWorkOrder[]
  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 1.1): party master.
  customers           Customer[]
  vendors             Vendor[]
  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 2): transaction engine relations.
  salesOrders         SalesOrder[]
  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 9.2): quotes.
  quotes              Quote[] @relation("QuoteCompany")
  deliveryChallans    DeliveryChallan[]
  salesReturns        SalesReturn[]
  purchaseReturns     PurchaseReturn[]
  creditNotes         CreditNote[]
  debitNotes          DebitNote[]
  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 3.2/3.3): warehouse ops.
  transferOrders      TransferOrder[]
  stockCounts         StockCount[]

  @@map("companies")
}

// ------------------------------------------------------------------
// INVENTORY_HORIZONTAL_PLATFORM (Phase 1.1) — Party master
// ------------------------------------------------------------------

/// Customer master (AR) — inventory tenants pick a customer instead of retyping
/// client name/phone/address/GSTIN on every sales invoice. Free-text invoice
/// clientName stays for legacy rows; `Invoice.customerId` links when set.
model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  businessName   String?  @map("business_name")
  gstin          String?
  pan            String?
  billingAddress String?  @map("billing_address")
  shippingAddress String? @map("shipping_address")
  phone          String?
  email          String?
  paymentTerms   String?  @map("payment_terms")
  creditLimit    Decimal? @default(0) @map("credit_limit") @db.Decimal(14, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 2): transaction engine relations.
  salesOrders SalesOrder[]
  deliveryChallans DeliveryChallan[]
  salesReturns SalesReturn[]
  creditNotes CreditNote[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 9.1): per-customer price overrides.
  priceList CustomerPrice[] @relation("CustomerPrice")
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 9.2): quotes for a customer.
  quotes Quote[] @relation("QuoteCustomer")

  @@index([companyId])
  @@map("customers")
}

// ------------------------------------------------------------------
// INVENTORY_HORIZONTAL_PLATFORM (Phase 9.1) — Customer price lists
// ------------------------------------------------------------------
// Per-customer rate override for a resource. `customerId = null` is the
// company-default price for that resource (one row per resource — enforced by
// the service with an upsert-style lookup, since Postgres unique constraints
// treat NULLs as distinct).
model CustomerPrice {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  rate       Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer? @relation("CustomerPrice", fields: [customerId], references: [id], onDelete: Cascade)
  resource Resource  @relation("CustomerPrice", fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([resourceId])
  @@index([customerId])
  @@map("customer_prices")
}

// ------------------------------------------------------------------
// INVENTORY_HORIZONTAL_PLATFORM (Phase 9.2) — Quote → Sales Order
// ------------------------------------------------------------------
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  projectId    String      @map("project_id") @db.Uuid
  quoteNumber  String      @map("quote_number")
  customerId   String?     @map("customer_id") @db.Uuid
  customerName String      @map("customer_name")
  status       QuoteStatus @default(DRAFT)
  quoteDate    DateTime    @map("quote_date") @db.Date
  validUntil   DateTime?   @map("valid_until") @db.Date
  subtotal     Decimal     @default(0) @db.Decimal(14, 2)
  gstAmount    Decimal     @default(0) @map("gst_amount") @db.Decimal(14, 2)
  total        Decimal     @default(0) @db.Decimal(14, 2)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  company  Company     @relation("QuoteCompany", fields: [companyId], references: [id], onDelete: Cascade)
  project  Project     @relation("QuoteProject", fields: [projectId], references: [id], onDelete: Cascade)
  customer Customer?   @relation("QuoteCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  lines    QuoteLine[]
  salesOrder SalesOrder? @relation("QuoteSalesOrder", fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesOrderId String?  @unique @map("sales_order_id") @db.Uuid

  @@unique([companyId, quoteNumber])
  @@index([projectId])
  @@map("quotes")
}

model QuoteLine {
  id         String  @id @default(uuid()) @db.Uuid
  quoteId    String  @map("quote_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  itemName   String  @map("item_name")
  unit       String
  quantity   Decimal @db.Decimal(12, 3)
  rate       Decimal @db.Decimal(12, 2)
  amount     Decimal @default(0) @db.Decimal(14, 2)
  gstRate    Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_lines")
}

/// Vendor master (AP) — inventory tenants pick a vendor instead of retyping
/// vendor name/GSTIN on every bill. Free-text bill vendorName stays for legacy
/// rows; `Bill.vendorId` links when set.
model Vendor {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  businessName   String?  @map("business_name")
  gstin          String?
  pan            String?
  billingAddress String?  @map("billing_address")
  shippingAddress String? @map("shipping_address")
  phone          String?
  email          String?
  paymentTerms   String?  @map("payment_terms")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bills   Bill[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 2): transaction engine relations.
  purchaseReturns PurchaseReturn[]
  debitNotes DebitNote[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 4.1): preferred vendor on resources.
  preferredResources Resource[] @relation("ResourcePreferredVendor")

  @@index([companyId])
  @@map("vendors")
}

// ------------------------------------------------------------------
// 2. User                                                            
// ------------------------------------------------------------------

model User {
id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(PM)
  isActive     Boolean  @default(true) @map("is_active")
  notificationPrefs Json? @map("notification_prefs")
  createdAt    DateTime @default(now()) @map("created_at")

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectsCreated      Project[]     @relation("ProjectCreatedBy")
  tasksAssigned        Task[]        @relation("TaskAssignedTo")
  dailyReports         DailyReport[] @relation("DailyReportReportedBy")
  attendances          Attendance[]  @relation("UserAttendance")
  estimatesCreated     Estimate[]    @relation("EstimateCreatedBy")
  estimatesApproved    Estimate[]    @relation("EstimateApprovedBy")
  billsApproved        Bill[]        @relation("BillApprovedBy")
  journalEntries       JournalEntry[] @relation("JournalEntryCreatedBy")
  priceHistoryRecorded MaterialPriceHistory[] @relation("PriceHistoryRecordedBy")
  chatMessages         ChatMessage[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  invitesSent          UserInvite[] @relation("InvitesSent")
  ticketsCreated       SupportTicket[] @relation("TicketsCreated")
  projectMembers       ProjectMember[]
  changeOrdersCreated  ChangeOrder[] @relation("ChangeOrderCreatedBy")
  changeOrdersApproved ChangeOrder[] @relation("ChangeOrderApprovedBy")
  portalAccessCreated  ClientPortalAccess[] @relation("PortalAccessCreatedBy")
  subPortalAccessCreated SubcontractorPortalAccess[] @relation("SubPortalCreatedBy")
  proposalsCreated     Proposal[] @relation("ProposalCreatedBy")
  boqMeasurementsRecorded BoqMeasurement[] @relation("BoqMeasurementRecordedBy")
  subcontractMaterialIssues SubcontractorMaterialIssue[] @relation("SubcontractMaterialIssuedBy")
  pettyCashEntries     PettyCashEntry[] @relation("PettyCashRecordedBy")
  punchItemsAssigned   PunchItem[] @relation("PunchItemAssignedTo")
  punchItemsClosed     PunchItem[] @relation("PunchItemClosedBy")
  punchItemsCreated    PunchItem[] @relation("PunchItemCreatedBy")
  rfisRaised           RFI[] @relation("RFIRaisedBy")
  drawingsCreated      Drawing[] @relation("DrawingCreatedBy")
  drawingVersionsUploaded DrawingVersion[] @relation("DrawingVersionUploadedBy")
  rfisAnswered         RFI[] @relation("RFIAnsweredBy")
  submittalsSubmitted  Submittal[] @relation("SubmittalSubmittedBy")
  submittalsReviewed   Submittal[] @relation("SubmittalReviewedBy")

  @@index([companyId])
  @@map("users")
}

// ------------------------------------------------------------------
// 2b. UserInvite (team onboarding)
// ------------------------------------------------------------------

model UserInvite {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  email       String
  role        Role      @default(PM)
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@map("user_invites")
}

// ------------------------------------------------------------------
// 3. Project
// ------------------------------------------------------------------

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  code            String
  type            ProjectType
  status          ProjectStatus @default(PLANNING)
  clientName      String   @map("client_name")
  clientContact   String?  @map("client_contact")
  locationLat     Float?   @map("location_lat")
  locationLng     Float?   @map("location_lng")
  locationAddress String?  @map("location_address")
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  budget          Decimal  @default(0) @db.Decimal(14, 2)
  isTemporary     Boolean  @default(false) @map("is_temporary")
  rateRegionId    String?  @map("rate_region_id") @db.Uuid
  proposalId      String?  @unique @map("proposal_id") @db.Uuid
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rateRegion     RateRegion? @relation(fields: [rateRegionId], references: [id], onDelete: SetNull)
  proposal       Proposal?  @relation("ProjectProposal", fields: [proposalId], references: [id], onDelete: SetNull)
  proposalAsTemp Proposal?  @relation("ProposalTempProject")
  /// INVENTORY_PRODUCT: back-relation for a company's default store project.
  companyAsDefault Company? @relation("CompanyDefaultProject")
  proposalAsPromoted Proposal? @relation("ProposalPromotedProject")
  createdByUser  User       @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  wbsItems       WBSItem[]
  tasks          Task[]
  boqItems       BOQItem[]
  estimates      Estimate[]
  dailyReports   DailyReport[]
  attendances    Attendance[]
  invoices       Invoice[]
  bills          Bill[]
  journalEntries JournalEntry[]
  chatMessages   ChatMessage[]
  members              ProjectMember[]
  changeOrders         ChangeOrder[]
  materialRequisitions MaterialRequisition[]
  purchaseOrders       PurchaseOrder[]
  goodsReceiptNotes    GoodsReceiptNote[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 9.2): quotes belong to the store project.
  quotes               Quote[] @relation("QuoteProject")
  stockLocations       StockLocation[]
  subcontractWorkOrders SubcontractWorkOrder[]
  portalAccess         ClientPortalAccess[]
  subcontractorPortalAccess SubcontractorPortalAccess[]
  boqMeasurements      BoqMeasurement[]
  projectMaterialRates ProjectMaterialRate[]
  pettyCashEntries     PettyCashEntry[] @relation("PettyCashProject")
  punchItems           PunchItem[]
  rfis                 RFI[]
  drawings             Drawing[]
  submittals           Submittal[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isTemporary])
  @@index([rateRegionId])
  @@map("projects")
}

// ------------------------------------------------------------------
// 3b. Proposal (pre-project quoting)                                  
// ------------------------------------------------------------------

model Proposal {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  title              String
  clientName         String         @map("client_name")
  clientContact      String?        @map("client_contact")
  projectType        ProjectType    @map("project_type")
  status             ProposalStatus @default(DRAFT)
  temporaryProjectId String         @unique @map("temporary_project_id") @db.Uuid
  promotedProjectId  String?        @unique @map("promoted_project_id") @db.Uuid
  validUntil         DateTime?      @map("valid_until") @db.Date
  notes              String?
  rejectionReason    String?        @map("rejection_reason")
  createdBy          String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  temporaryProject Project @relation("ProposalTempProject", fields: [temporaryProjectId], references: [id], onDelete: Cascade)
  promotedProject  Project? @relation("ProposalPromotedProject", fields: [promotedProjectId], references: [id], onDelete: SetNull)
  createdByUser    User    @relation("ProposalCreatedBy", fields: [createdBy], references: [id])
  linkedProject    Project? @relation("ProjectProposal")

  @@index([companyId])
  @@index([status])
  @@map("proposals")
}

// ------------------------------------------------------------------
// 4. WBSItem (self-relation)                                         
// ------------------------------------------------------------------

model WBSItem {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  code       String
  name       String
  level      Int      @default(1)
  orderIndex Int      @default(0) @map("order_index")

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    WBSItem?  @relation("WBSChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  WBSItem[] @relation("WBSChildren")
  tasks     Task[]
  boqItems  BOQItem[]

  @@index([projectId])
  @@index([parentId])
  @@map("wbs_items")
}

// ------------------------------------------------------------------
// 5. Task                                                            
// ------------------------------------------------------------------

model Task {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  wbsId          String?  @map("wbs_id") @db.Uuid
  name           String
  description    String?
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  durationDays   Int      @default(1) @map("duration_days")
  progressPct    Int      @default(0) @map("progress_pct") /// 0–100 enforced via DB CHECK constraint (migration 20260730120200)
  status         TaskStatus @default(NOT_STARTED)
  assignedTo     String?  @map("assigned_to") @db.Uuid
  constraintType TaskConstraintType? @map("constraint_type")
  isMilestone    Boolean  @default(false) @map("is_milestone")
  createdAt      DateTime @default(now()) @map("created_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbs          WBSItem?          @relation(fields: [wbsId], references: [id], onDelete: SetNull)
  assignee     User?             @relation("TaskAssignedTo", fields: [assignedTo], references: [id])
  resources    TaskResource[]
  predecessors TaskPredecessor[] @relation("TaskSuccessors")
  successors   TaskPredecessor[] @relation("TaskPredecessors")
  materialUsages MaterialUsage[]
  dailyReportTaskUpdates DailyReportTaskUpdate[]
  linkedChangeOrders ChangeOrder[]
  subcontractWorkOrders SubcontractWorkOrder[]
  punchItems          PunchItem[]
  rfis                RFI[]
  submittals          Submittal[]

  @@index([projectId])
  @@index([wbsId])
  @@index([status])
  @@map("tasks")
}

// ------------------------------------------------------------------
// 6. TaskPredecessor                                                 
// ------------------------------------------------------------------

model TaskPredecessor {
  id             String         @id @default(uuid()) @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  predecessorId  String         @map("predecessor_id") @db.Uuid
  type           DependencyType @default(FS)
  lagDays        Int            @default(0) @map("lag_days")

  task        Task @relation("TaskSuccessors", fields: [taskId], references: [id], onDelete: Cascade)
  predecessor Task @relation("TaskPredecessors", fields: [predecessorId], references: [id], onDelete: Cascade)

  @@unique([taskId, predecessorId])
  @@map("task_predecessors")
}

// ------------------------------------------------------------------
// 7. Resource                                                        
// ------------------------------------------------------------------

model Resource {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  name             String
  type             ResourceType
  unit             String
  rate             Decimal  @default(0) @db.Decimal(12, 2)
  gstRate          Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  hsnSacCode       String?  @map("hsn_sac_code")
  brandOrSpec      String?  @map("brand_or_spec")
  category         String?
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 1.2): item master fields — all optional
  // so construction resource/estimate flows are unaffected.
  sku              String?  @map("sku")
  itemCode         String?  @map("item_code")
  barcode          String?  @map("barcode")
  secondaryUnit    String?  @map("secondary_unit")
  conversionFactor Decimal? @default(1) @map("conversion_factor") @db.Decimal(12, 4)
  /// Low-stock threshold for basic reorder reports (Phase 1.5).
  reorderPoint     Decimal? @default(0) @map("reorder_point") @db.Decimal(12, 3)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 4.1): procurement automation fields —
  // all optional so construction resource/estimate flows are unaffected.
  preferredVendorId String?  @map("preferred_vendor_id") @db.Uuid
  /// Reorder quantity for one-click purchase (fallback = reorderPoint - onHand).
  reorderQty       Decimal? @map("reorder_qty") @db.Decimal(12, 3)
  /// Procurement lead time in days (informational; no planning engine yet).
  leadTimeDays     Int?     @map("lead_time_days")
  /// INVENTORY_HORIZONTAL_PLATFORM (Phase 5.2): running weighted-average unit
  /// cost per company (v1). Updated on stock IN; OUT movements carry it as
  /// metadata. `rate` remains the catalog/selling price.
  avgCost          Decimal  @default(0) @map("avg_cost") @db.Decimal(14, 4)
  imageUrl         String?  @map("image_url")
  lastRateUpdatedAt DateTime? @map("last_rate_updated_at")
  isActive         Boolean  @default(true) @map("is_active")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  createdAt        DateTime @default(now()) @map("created_at")

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  preferredVendor    Vendor?              @relation("ResourcePreferredVendor", fields: [preferredVendorId], references: [id], onDelete: SetNull)
  taskResources      TaskResource[]
  estimateItems      EstimateItem[]
  rateAnalysisComponents RateAnalysisComponent[]
  priceHistory       MaterialPriceHistory[]
  materialUsages     MaterialUsage[]
  requisitionLines   MaterialRequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  subcontractorMaterialIssues SubcontractorMaterialIssue[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 8.4): invoice line links for true margins.
  invoiceLineItems   InvoiceLineItem[]
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 9.1): customer price overrides.
  customerPrices     CustomerPrice[] @relation("CustomerPrice")
  changeOrderLines   ChangeOrderLine[]
  regionalMaterialRates RegionalMaterialRate[]
  projectMaterialRates ProjectMaterialRate[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@index([type])
  @@map("resources")
}

// ------------------------------------------------------------------
// 8. TaskResource                                                    
// ------------------------------------------------------------------

model TaskResource {
  id         String  @id @default(uuid()) @db.Uuid
  taskId     String  @map("task_id") @db.Uuid
  resourceId String  @map("resource_id") @db.Uuid
  quantity   Decimal @db.Decimal(12, 3)
  unit       String
  rate       Decimal @db.Decimal(12, 2)
  totalCost  Decimal @default(0) @map("total_cost") @db.Decimal(14, 2)

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([taskId, resourceId])
  @@map("task_resources")
}

// ------------------------------------------------------------------
// 9. BOQItem                                                         
// ------------------------------------------------------------------

model BOQItem {
  id            String  @id @default(uuid()) @db.Uuid
  projectId     String  @map("project_id") @db.Uuid
  wbsId         String? @map("wbs_id") @db.Uuid
  itemCode      String  @map("item_code")
  description   String
  unit          String
  quantity      Decimal @db.Decimal(12, 3)
  rate          Decimal @db.Decimal(12, 2)
  amount        Decimal @default(0) @db.Decimal(14, 2)
  category      String?
  section       String?
  estimateItemId String? @map("estimate_item_id") @db.Uuid @unique
  isSuperseded  Boolean @default(false) @map("is_superseded")
  executedQty   Decimal @default(0) @map("executed_qty") @db.Decimal(12, 3)
  procuredQty   Decimal @default(0) @map("procured_qty") @db.Decimal(12, 3)
  // VAR-C6: Direct RA link for variation-created BOQ rows (no estimateItem).
  resourceId     String?  @map("resource_id") @db.Uuid
  rateAnalysisId String?  @map("rate_analysis_id") @db.Uuid

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbs           WBSItem?          @relation(fields: [wbsId], references: [id], onDelete: SetNull)
  estimateItem  EstimateItem?     @relation(fields: [estimateItemId], references: [id])
  invoiceLines  InvoiceLineItem[]
  measurements  BoqMeasurement[]
  materialUsages MaterialUsage[]
  subcontractWorkOrders SubcontractWorkOrder[]
  subcontractWorkOrderLines SubcontractWorkOrderLine[]
  subcontractMeasurementLines SubcontractMeasurementLine[]
  // SUB-BOQ1B: Back-relation for material issues linked to this BOQ line
  subcontractorMaterialIssues SubcontractorMaterialIssue[] @relation("SubcontractorMaterialIssueBoqItem")

  @@index([projectId])
  @@index([category])
  @@map("boq_items")
}

// ------------------------------------------------------------------
// 10. Estimate                                                       
// ------------------------------------------------------------------

model Estimate {
  id                     String         @id @default(uuid()) @db.Uuid
  projectId              String         @map("project_id") @db.Uuid
  companyId              String         @map("company_id") @db.Uuid
  parentId               String?        @map("parent_id") @db.Uuid
  name                   String
  version                Int            @default(1)
  status                 EstimateStatus @default(DRAFT)
  totalMaterialCost      Decimal        @default(0) @map("total_material_cost") @db.Decimal(14, 2)
  totalLabourCost        Decimal        @default(0) @map("total_labour_cost") @db.Decimal(14, 2)
  totalEquipmentCost     Decimal        @default(0) @map("total_equipment_cost") @db.Decimal(14, 2)
  totalSubcontractorCost Decimal        @default(0) @map("total_subcontractor_cost") @db.Decimal(14, 2)
  totalMiscCost          Decimal        @default(0) @map("total_misc_cost") @db.Decimal(14, 2)
  subtotal               Decimal        @default(0) @db.Decimal(14, 2)
  overheadPct            Decimal        @default(0) @map("overhead_pct") @db.Decimal(5, 2)
  overheadAmount         Decimal        @default(0) @map("overhead_amount") @db.Decimal(14, 2)
  contingencyPct         Decimal        @default(0) @map("contingency_pct") @db.Decimal(5, 2)
  contingencyAmount      Decimal        @default(0) @map("contingency_amount") @db.Decimal(14, 2)
  profitMarginPct        Decimal        @default(0) @map("profit_margin_pct") @db.Decimal(5, 2)
  profitMarginAmount     Decimal        @default(0) @map("profit_margin_amount") @db.Decimal(14, 2)
  gstAmount              Decimal        @default(0) @map("gst_amount") @db.Decimal(14, 2)
  grandTotal             Decimal        @default(0) @map("grand_total") @db.Decimal(14, 2)
  notes                  String?
  rejectionReason        String?        @map("rejection_reason")
  approvedBy             String?        @map("approved_by") @db.Uuid
  approvedAt             DateTime?      @map("approved_at")
  createdBy              String         @map("created_by") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Estimate?        @relation("EstimateChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Estimate[]      @relation("EstimateChildren")
  approvedByUser User?         @relation("EstimateApprovedBy", fields: [approvedBy], references: [id])
  createdByUser  User          @relation("EstimateCreatedBy", fields: [createdBy], references: [id])
  sections    EstimateSection[]
  items       EstimateItem[]
  changeOrders ChangeOrder[] @relation("EstimateChangeOrders")

  @@index([projectId])
  @@index([companyId])
  @@index([parentId])
  @@index([status])
  // FIX (DAT-3.6): Composite index for tenant+status queries.
  @@index([companyId, status])
  @@map("estimates")
}

// ------------------------------------------------------------------
// 11. EstimateSection                                                
// ------------------------------------------------------------------

model EstimateSection {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  name        String
  orderIndex  Int      @default(0) @map("order_index")
  description String?

  estimate Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  items    EstimateItem[]

  @@index([estimateId])
  @@map("estimate_sections")
}

// ------------------------------------------------------------------
// 12. EstimateItem                                                   
// ------------------------------------------------------------------

model EstimateItem {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  wbsItemId   String?  @map("wbs_item_id") @db.Uuid
  itemCode    String?  @map("item_code")
  description String
  unit        String
  quantity    Decimal  @db.Decimal(12, 3)
  resourceId      String?  @map("resource_id") @db.Uuid
  rateAnalysisId  String?  @map("rate_analysis_id") @db.Uuid
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(14, 2)
  type        CostType @default(MISC)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  estimate  Estimate   @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section   EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parent    EstimateItem?  @relation("EstimateItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  EstimateItem[] @relation("EstimateItemChildren")
  resource  Resource?  @relation(fields: [resourceId], references: [id])
  rateAnalysis RateAnalysis? @relation(fields: [rateAnalysisId], references: [id], onDelete: SetNull)
  boqItem   BOQItem?

  @@index([estimateId])
  @@index([sectionId])
  @@index([parentId])
  @@index([type])
  @@index([rateAnalysisId])
  @@map("estimate_items")
}

// ------------------------------------------------------------------
// 13. RateAnalysis                                                   
// ------------------------------------------------------------------

model RateAnalysis {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  unit        String
  description String?
  totalRate   Decimal  @default(0) @map("total_rate") @db.Decimal(12, 2)
  stale       Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  components RateAnalysisComponent[]
  estimateItems EstimateItem[]
  changeOrderLines ChangeOrderLine[]

  @@index([companyId])
  @@map("rate_analyses")
}

// ------------------------------------------------------------------
// 14. RateAnalysisComponent                                          
// ------------------------------------------------------------------

model RateAnalysisComponent {
  id              String   @id @default(uuid()) @db.Uuid
  rateAnalysisId  String   @map("rate_analysis_id") @db.Uuid
  resourceId      String?  @map("resource_id") @db.Uuid
  miscName        String?  @map("misc_name")
  quantityPerUnit Decimal  @map("quantity_per_unit") @db.Decimal(12, 4)
  unit            String
  rate            Decimal  @db.Decimal(12, 2)
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  type            CostType @default(MISC)

  rateAnalysis RateAnalysis @relation(fields: [rateAnalysisId], references: [id], onDelete: Cascade)
  resource     Resource?    @relation(fields: [resourceId], references: [id])

  @@index([rateAnalysisId])
  @@map("rate_analysis_components")
}

// ------------------------------------------------------------------
// 15. MaterialPriceHistory                                           
// ------------------------------------------------------------------

model MaterialPriceHistory {
  id            String   @id @default(uuid()) @db.Uuid
  resourceId    String   @map("resource_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
