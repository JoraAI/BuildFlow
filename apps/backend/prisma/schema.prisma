  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([companyId])
  @@map("platform_audit_logs")
}

// ------------------------------------------------------------------
// RFIs & Submittals (Phase 5 — §8.2)
// Requests for Information and technical submittals with answer tracking,
// document attachments, and approval workflow.
// ------------------------------------------------------------------

model RFI {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  boqItemId   String?  @map("boq_item_id") @db.Uuid
  rfiNumber   String   @map("rfi_number")
  subject     String
  question    String
  answer      String?
  status      String   @default("OPEN") // OPEN | ANSWERED | CLOSED | CANCELLED
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  attachments String[] @default([])
  raisedBy    String   @map("raised_by") @db.Uuid
  answeredBy  String?  @map("answered_by") @db.Uuid
  answeredAt  DateTime? @map("answered_at")
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  raisedByUser  User @relation("RFIRaisedBy", fields: [raisedBy], references: [id])
  answeredByUser User? @relation("RFIAnsweredBy", fields: [answeredBy], references: [id])

  @@unique([companyId, rfiNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("rfis")
}

model Submittal {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  taskId       String?  @map("task_id") @db.Uuid
  submittalNo  String   @map("submittal_no")
  title        String
  description  String?
  type         String   @default("MATERIAL") // MATERIAL | SHOP_DRAWING | METHOD_STATEMENT | OTHER
  status       String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | REVISE
  attachments  String[] @default([])
  submittedBy  String   @map("submitted_by") @db.Uuid
  reviewedBy   String?  @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?  @map("review_notes")
  dueDate      DateTime? @map("due_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  submittedByUser User @relation("SubmittalSubmittedBy", fields: [submittedBy], references: [id])
  reviewedByUser  User? @relation("SubmittalReviewedBy", fields: [reviewedBy], references: [id])

  @@unique([companyId, submittalNo])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("submittals")
}

// ------------------------------------------------------------------
// Punch List / Snag List (Phase 5 — §8.4)
// Plan/location-anchored snags with photo capture, assignee, priority, due
// date, status (open → in-progress → ready-for-review → closed).
// ------------------------------------------------------------------

model PunchItem {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  title       String
  description String?
  location    String?
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | READY_FOR_REVIEW | CLOSED
  photos      String[] @default([])
  assignedTo  String?  @map("assigned_to") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Date
  closedAt    DateTime? @map("closed_at")
  closedBy    String?  @map("closed_by") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  assignee User?   @relation("PunchItemAssignedTo", fields: [assignedTo], references: [id])
  closer   User?   @relation("PunchItemClosedBy", fields: [closedBy], references: [id])
  creator  User    @relation("PunchItemCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@index([companyId, status])
  @@map("punch_items")
}

// ------------------------------------------------------------------
// Petty Cash / Site Expenses (Phase 5 — §8.9)
// Tracks small cash expenditures at site with receipt tracking and
// categorized reconciliation. Each entry is company+project scoped.
// ------------------------------------------------------------------

model PettyCashEntry {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  entryNumber String   @map("entry_number")
  description String
  category    String   @default("OTHER")
  amount      Decimal  @db.Decimal(14, 2)
  expenseDate DateTime @map("expense_date") @db.Date
  paidTo      String   @map("paid_to")
  receiptUrl  String?  @map("receipt_url")
  notes       String?
  /// PENDING | RECONCILED | REJECTED
  status      String   @default("PENDING")
  recordedBy  String   @map("recorded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  Project? @relation("PettyCashProject", fields: [projectId], references: [id], onDelete: SetNull)
  recorder User     @relation("PettyCashRecordedBy", fields: [recordedBy], references: [id])

  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([projectId])
  @@index([companyId, status])
  @@map("petty_cash_entries")
}

// ------------------------------------------------------------------
// Document Counter (race-safe, per-company, per-year sequential numbers)
// FIX: SEC-M14 / FIN-H1 / DAT-1.2 — replaces count()-based numbering.
// ------------------------------------------------------------------

model DocumentCounter {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  /// 'indent' | 'bill' | 'invoice' | 'po' | 'grn'
  type      String
  year      Int
  lastSeq   Int      @default(0) @map("last_seq")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, year])
  @@index([companyId])
  @@map("document_counters")
}

// ------------------------------------------------------------------
// Drawing & Document Version Control (Phase 5 — §8.3)
// Version-tracked drawings with discipline, status workflow, and revision history.
// ------------------------------------------------------------------

model Drawing {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  drawingNo   String   @map("drawing_no")
  title       String
  discipline  String   @default("CIVIL") // CIVIL | STRUCTURAL | MEP | ARCHITECTURAL | OTHER
  category    String?
  status      String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | SUPERSEDED
  currentVersionId String? @unique @map("current_version_id") @db.Uuid
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentVersion DrawingVersion? @relation("DrawingCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions      DrawingVersion[] @relation("DrawingVersions")
  createdByUser User             @relation("DrawingCreatedBy", fields: [createdBy], references: [id])

  @@unique([companyId, drawingNo])
  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("drawings")
}

model DrawingVersion {
  id          String   @id @default(uuid()) @db.Uuid
  drawingId   String   @map("drawing_id") @db.Uuid
  versionLabel String  @map("version_label") // e.g. "Rev A", "Rev B"
  fileUrl     String   @map("file_url")
  thumbnailUrl String? @map("thumbnail_url")
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  notes       String?

  drawing        Drawing @relation("DrawingVersions", fields: [drawingId], references: [id], onDelete: Cascade)
  currentForDrawing Drawing? @relation("DrawingCurrentVersion")
  uploadedByUser User    @relation("DrawingVersionUploadedBy", fields: [uploadedBy], references: [id])

  @@unique([drawingId, versionLabel])
  @@index([drawingId])
  @@map("drawing_versions")
}
