model CreditNote {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  creditNoteNumber String    @map("credit_note_number")
  invoiceId        String?   @map("invoice_id") @db.Uuid
  salesReturnId    String?   @unique @map("sales_return_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  customerName     String    @map("customer_name")
  creditDate       DateTime  @map("credit_date") @db.Date
  status           NoteStatus @default(DRAFT)
  subtotal         Decimal   @default(0) @db.Decimal(14, 2)
  gstAmount        Decimal   @default(0) @map("gst_amount") @db.Decimal(14, 2)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 5.5): GST state split on the note
  // (CGST/SGST when same-state, IGST otherwise) — mirrors invoice/bill logic.
  cgstAmount       Decimal   @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount       Decimal   @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount       Decimal   @default(0) @map("igst_amount") @db.Decimal(14, 2)
  total            Decimal   @default(0) @db.Decimal(14, 2)
  notes            String?
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  salesReturn SalesReturn? @relation(fields: [salesReturnId], references: [id], onDelete: SetNull)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines       CreditNoteLine[]

  @@index([companyId])
  @@unique([companyId, creditNoteNumber])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String  @id @default(uuid()) @db.Uuid
  creditNoteId String  @map("credit_note_id") @db.Uuid
  resourceId   String? @map("resource_id") @db.Uuid
  description  String
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  rate         Decimal @default(0) @db.Decimal(12, 2)
  amount       Decimal @default(0) @db.Decimal(14, 2)
  gstRate      Decimal @default(0) @map("gst_rate") @db.Decimal(5, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  @@index([creditNoteId])
  @@map("credit_note_lines")
}

model DebitNote {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  debitNoteNumber String  @map("debit_note_number")
  billId        String?   @map("bill_id") @db.Uuid
  purchaseReturnId String? @unique @map("purchase_return_id") @db.Uuid
  vendorId      String?   @map("vendor_id") @db.Uuid
  vendorName    String    @map("vendor_name")
  debitDate     DateTime  @map("debit_date") @db.Date
  status        NoteStatus @default(DRAFT)
  subtotal      Decimal   @default(0) @db.Decimal(14, 2)
  gstAmount     Decimal   @default(0) @map("gst_amount") @db.Decimal(14, 2)
  // INVENTORY_HORIZONTAL_PLATFORM (Phase 5.5): GST state split on the note.
  cgstAmount    Decimal   @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount    Decimal   @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount    Decimal   @default(0) @map("igst_amount") @db.Decimal(14, 2)
  total         Decimal   @default(0) @db.Decimal(14, 2)
  notes         String?
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bill       Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)
