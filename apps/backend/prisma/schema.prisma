  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromLocation StockLocation       @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation   StockLocation       @relation("TransferToLocation", fields: [toLocationId], references: [id])
  lines        TransferOrderLine[]

  @@index([companyId])
