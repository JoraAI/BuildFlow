{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "construction": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "construction",
        "EXPO_PUBLIC_API_URL": "https://buildflow-api-backend.onrender.com/api"
      }
    },
    "construction-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "construction",
        "EXPO_PUBLIC_API_URL": "https://buildflow-api-backend.onrender.com/api"
      }
    },
    "inventory": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "inventory",
        "EXPO_PUBLIC_API_URL": "https://buildflow-api-backend.onrender.com/api"
      }
    },
    "inventory-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "inventory",
        "EXPO_PUBLIC_API_URL": "https://buildflow-api-backend.onrender.com/api"
      }
    }
  },
  "submit": {
    "construction": {
      "android": {
        "track": "internal",
        "applicationId": "com.jora.buildflow"
      }
    },
    "inventory": {
      "android": {
        "track": "internal",
        "applicationId": "com.jora.buildflow.inventory"
      }
    }
  }
}
