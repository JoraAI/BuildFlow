{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --filter @buildflow/mobile...",
  "buildCommand": "cd ../.. && pnpm --filter @buildflow/mobile run build:web",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/privacy", "destination": "/privacy.html", "permanent": false },
    { "source": "/terms", "destination": "/terms.html", "permanent": false },
    { "source": "/sms-opt-in", "destination": "/sms-opt-in.html", "permanent": false },
    { "source": "/delete-account", "destination": "/delete-account.html", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/((?!privacy\\.html|terms\\.html|sms-opt-in\\.html|delete-account\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
